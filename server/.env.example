# Copy to .env for running the server on your computer (npm run dev). Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=PrimeCare
MONGODB_DB=primecare
# Any long random string, at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
HOSPITAL_TZ=Asia/Kolkata
PORT=3000
